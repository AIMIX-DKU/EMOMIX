# ============================================================
# 사용법: "=" 바로 뒤에 값을 붙여 넣는다. 따옴표·공백 없이.
# 이 파일의 복사본인 .env 를 채우면 된다(.env 는 git에 올라가지 않는다).
# 지금 당장 필요한 건 [1] 뿐이다. 나머지는 준비되는 대로 채운다.
# ============================================================

# ---------- [1] Neon DB (지금 필요) ----------
# Neon 콘솔 → 왼쪽 위 초록색 [Connect] 버튼
#   DATABASE_URL: "Connection pooling" 스위치를 켠 상태의 문자열 (호스트에 -pooler 포함)
#   DIRECT_URL  : 같은 화면에서 스위치를 끈 상태의 문자열
#   둘 다 postgresql://... 로 시작하는 한 줄 전체를 그대로 붙여 넣는다.
DATABASE_URL=
DIRECT_URL=

# ---------- [2] 서버 기본값 (이미 채워져 있음, 그대로 두면 됨) ----------
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=
WORKER_API_KEY=

# ---------- [3] Discord 로그인 ----------
# Discord Developer Portal → Applications → 앱 선택 → OAuth2
#   Client ID / Client Secret(Reset Secret 으로 확인)
#   Redirects 에 아래 주소를 등록: http://localhost:3000/api/v1/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/v1/auth/discord/callback

# ---------- [4] Toss Payments (테스트 키만) ----------
# 토스페이먼츠 개발자센터 → 내 개발 정보 → API 키 → 테스트 키
#   클라이언트 키: test_ck_ 로 시작 / 시크릿 키: test_sk_ 로 시작
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ---------- [5] 이메일 발송 (둘 중 하나만 채운다) ----------
# (a) Gmail SMTP: 구글 계정 → 보안 → 2단계 인증 켜기 → 앱 비밀번호 생성(16자리, 공백 제거)
SMTP_USER=
SMTP_PASS=
# (b) Resend 를 쓸 경우
RESEND_API_KEY=

# ---------- [6] 파일 스토리지 (S3 호환) ----------
# Neon Object storage 또는 Cloudflare R2 에서 발급한 값
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 업로드된 파일을 브라우저에서 볼 때 쓰는 공개 주소 (없으면 비워 둠)
S3_PUBLIC_BASE_URL=

# ---------- [7] 관리자 계정 시드 ----------
ADMIN_EMAIL=
ADMIN_PASSWORD=
