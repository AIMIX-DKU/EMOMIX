{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "regions": ["iad1"],
  "functions": {
    "api/index.js": { "maxDuration": 30, "memory": 1024, "includeFiles": "dist/**" }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
